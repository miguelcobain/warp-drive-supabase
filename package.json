{
  "name": "warp-drive-supabase",
  "version": "0.6.0",
  "description": "Supabase request builders and handlers for Warp Drive",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.28.2",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./builders": {
      "types": "./dist/builders.d.ts",
      "import": "./dist/builders.js",
      "require": "./dist/builders.cjs"
    },
    "./handlers": {
      "types": "./dist/handlers.d.ts",
      "import": "./dist/handlers.js",
      "require": "./dist/handlers.cjs"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "require": "./dist/auth.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "ci:verify": "pnpm typecheck && pnpm test:library && pnpm test:app && pnpm build && pnpm smoke:pack",
    "clean": "rimraf dist .tmp",
    "test:app": "pnpm --filter test-app test",
    "test:library": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm test:library",
    "test:all": "pnpm test:library && pnpm test:app",
    "test:watch": "vitest",
    "pack:check": "pnpm build && pnpm pack",
    "smoke:pack": "pnpm build && node ./scripts/smoke-consumer.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@warp-drive/core": ">=5.7.0 <6",
    "@warp-drive/utilities": ">=5.7.0 <6"
  },
  "devDependencies": {
    "@rollup/plugin-babel": "^6.1.0",
    "@types/node": "^24.5.2",
    "@types/pluralize": "^0.0.33",
    "@warp-drive/core": "^5.7.0",
    "@warp-drive/utilities": "^5.7.0",
    "pluralize": "^8.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
